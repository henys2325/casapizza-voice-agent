# Casa de Pizza & Wings — Environment Variables
# Copy this file to .env and fill in the values

# Clover POS
CLOVER_MERCHANT_ID=your_merchant_id_here
CLOVER_API_TOKEN=your_api_token_here
CLOVER_BASE_URL=https://api.clover.com

# Authorize.net
AUTHNET_API_LOGIN_ID=your_login_id_here
AUTHNET_TRANSACTION_KEY=your_transaction_key_here
AUTHNET_SANDBOX=false

# Twilio SMS
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+17025551234

# Backend URL (used for payment redirect links)
BACKEND_URL=https://casapizza-voice-agent.onrender.com

# Vapi
VAPI_API_KEY=your_vapi_key_here
VAPI_AGENT_ID=your_agent_id_here
